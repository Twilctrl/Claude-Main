[Unit]
Description=hailcore first boot: check the Hailo-10H driver and pull the default model
Wants=network-online.target hailo-ollama.service
After=network-online.target hailo-ollama.service
ConditionPathExists=!/var/lib/hailcore/firstboot.done

[Service]
Type=oneshot
EnvironmentFile=-/etc/hailcore/hailcore.conf
ExecStart=/usr/local/lib/hailcore/firstboot.sh
TimeoutStartSec=45min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
