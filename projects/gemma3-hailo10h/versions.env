# Pinned versions for the Gemma 3 270M -> Hailo-10H project.
#
# Sourced by scripts/. A value marked TBC is a proposal: it is confirmed (or
# changed) the first time a phase uses it, and the change is logged in NOTES.md.
# Never put the Dataflow Compiler wheel, a HEF, or any other Hailo binary in
# this repository.

# --- Hailo compiler (proprietary; download it yourself from the Hailo Developer Zone)
# 5.3.0 is what the upstream compiler (v0.3.0-dfc5.3.0) was validated against.
# Hailo's current release is 5.4.0 (see docs/setup-checklist.md before switching).
DFC_VERSION=5.3.0
DFC_WHEEL=hailo_dataflow_compiler-5.3.0-py3-none-linux_x86_64.whl

# --- Device side (Raspberry Pi 5 + AI HAT+ 2): all from one suite drop
# The Raspberry Pi apt repo ships hailo-h10-all 5.1.1, older than this.
HAILORT_VERSION=5.3.0                  # PCIe driver + firmware + libhailort + python bindings
HAILO_GENAI_MODEL_ZOO_VERSION=5.3.0    # provides hailo-ollama (5.3.0 manifests use "hef_h10h")

# --- Upstream sources (public, MIT), fetched by scripts/00_fetch_upstream.sh
UPSTREAM_REPO=https://github.com/l-nmch/hailo-10h-llm-compiler
UPSTREAM_COMMIT=c870419f7d6315e1277e06a9fa5eadd955b8e1af        # tag v0.3.0-dfc5.3.0
UPSTREAM_WIKI_REPO=https://github.com/l-nmch/hailo-10h-llm-compiler.wiki.git
UPSTREAM_WIKI_COMMIT=540aa5da6522c68fc02103493ff608319043e314
HAILORT_SRC_REPO=https://github.com/hailo-ai/hailort
HAILORT_SRC_COMMIT=d503417f2a0db186a838390fb08690c4ea0f415e     # tag v5.3.0
GENAI_ZOO_SRC_REPO=https://github.com/hailo-ai/hailo_model_zoo_genai
GENAI_ZOO_SRC_COMMIT=1a3ba6be4af93dc58e675662c946a1a65198ec31   # tag v5.3.0

# --- Compile container (Python side). Upstream pins numpy/scipy/onnxruntime only.
BASE_IMAGE=ubuntu:22.04
PYTHON_VERSION=3.10
TORCH_VERSION=2.6.0            # what upstream's cu124 index resolves to; still has the legacy ONNX exporter
TRANSFORMERS_VERSION=4.57.6    # TBC in Phase 2 against gemma-3-270m-it's config.json
NUMPY_VERSION=2.1.3            # upstream pin; needs NPY_PROMOTION_STATE=legacy
SCIPY_VERSION=1.13.1           # upstream pin
ONNXRUNTIME_VERSION=1.20.1     # upstream pin
# onnx, tensorflow-cpu, protobuf, tensordict, torchvision: unpinned upstream.
# Frozen from `pip freeze` after the first successful Phase 1 build.

# --- Models (Hugging Face revisions)
TINYSTORIES_MODEL=Mxode/TinyStories-LLaMA2-25M-256h-4l-GQA
TINYSTORIES_REVISION=42d82ef2f206534234a249f58dc08ad32003cb9f
GEMMA_MODEL=google/gemma-3-270m-it                               # gated: accept the Gemma terms first
GEMMA_REVISION=ac82b4e820549b854eebf28ce6dedaf9fdfa17b3
